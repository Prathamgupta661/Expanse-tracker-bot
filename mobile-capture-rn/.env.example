# Copy this file to .env and fill in your own values.
# EXPO_PUBLIC_* values are embedded in the app bundle and readable by anyone
# with the APK - never put secrets (e.g. MOBILE_INGEST_SECRET) here.
# For EAS builds, set these with `eas env:create` instead of relying on .env.

# Backend base URL, without a trailing slash (e.g. your ngrok or deployed domain)
EXPO_PUBLIC_API_BASE_URL=https://your-backend-url-here
